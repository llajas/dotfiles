# ~/.dotfiles/functions/opencodeRemote.zsh

opencode-remote() {
  emulate -L zsh

  local root="$HOME/ghq"
  local current="${PWD:A}"
  local root_resolved="${root:A}"
  local remote_dir

  if ! command -v opencode >/dev/null 2>&1; then
    print -u2 -- "OpenCode client is unavailable."
    return 1
  fi

  case "$current" in
    "$root_resolved")
      remote_dir="/workspace/ghq"
      ;;
    "$root_resolved"/*)
      remote_dir="/workspace/ghq/${current#"$root_resolved"/}"
      ;;
    *)
      print -u2 -- "opencode-remote: $current is outside $root"
      return 1
      ;;
  esac

  if [[ -z "$OPENCODE_SERVER_USERNAME" || -z "$OPENCODE_SERVER_PASSWORD" || -z "$OPENCODE_SERVER_URL" ]]; then
    print -u2 -- "OpenCode remote credentials are empty."
    return 1
  fi

  command opencode attach "$OPENCODE_SERVER_URL" --dir "$remote_dir" "$@"
}
